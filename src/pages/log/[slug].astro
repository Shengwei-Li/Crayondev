---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("log", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const work = entry.data.work ? await getEntry("works", entry.data.work) : undefined;
const fmt = new Intl.DateTimeFormat("en-AU", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="wrap post">
    <p class="label">
      <time datetime={entry.data.date.toISOString()}>{fmt.format(entry.data.date)}</time>
      {work && <> · <a href={`/works/${work.id}`}>{work.data.title}</a></>}
    </p>
    <h1 class="title">{entry.data.title}</h1>
    <div class="body"><Content /></div>
  </article>
</Base>

<style>
  .post {
    max-width: calc(var(--text) + 2 * var(--gutter));
    padding-top: clamp(3rem, 12vh, 7rem);
    font-size: 1.125rem;
  }
  .title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .body {
    margin-top: 2.5rem;
  }
  .body > :global(* + *) {
    margin-top: 1.1rem;
  }
  .body > :global(h2) {
    margin-top: 3rem;
    font-size: 1.5rem;
  }
  .body :global(img) {
    width: 100%;
    background: var(--sky);
  }
</style>
