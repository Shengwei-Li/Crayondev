---
// A lead image that follows the visitor's system theme: `day` in light mode, `night` in dark mode.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  day: ImageMetadata;
  night?: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  pixel?: boolean;
}

const { day, night, alt, sizes = "100vw", eager = false, pixel = false } = Astro.props;
const widths = [640, 1280, 1920].filter((w) => w <= day.width);
const dayImg = await getImage({ src: day, widths, format: "webp" });
const nightImg = night ? await getImage({ src: night, widths, format: "webp" }) : null;
---

<picture>
  {nightImg && <source media="(prefers-color-scheme: dark)" srcset={nightImg.srcSet.attribute} sizes={sizes} />}
  <img
    src={dayImg.src}
    srcset={dayImg.srcSet.attribute}
    sizes={sizes}
    width={day.width}
    height={day.height}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class:list={{ pixel }}
  />
</picture>

<style>
  picture,
  img {
    display: block;
    width: 100%;
  }
  img {
    height: 100%;
    object-fit: cover;
    background: var(--sky);
  }
</style>
