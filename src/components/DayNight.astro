---
// A lead image with a day and a night version. Both are in the page; CSS shows the one that
// matches the current theme (system setting or the toggle), so switching needs no reload.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  day: ImageMetadata;
  night?: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
}

const { day, night, alt, sizes = "100vw", eager = false } = Astro.props;
const load = async (src: ImageMetadata) => {
  const widths = [640, 1280, 1920].filter((w) => w <= src.width);
  return { meta: src, img: await getImage({ src, widths, format: "webp" }) };
};
const versions = [{ cls: night ? "only-day" : "", ...(await load(day)) }];
if (night) versions.push({ cls: "only-night", ...(await load(night)) });
---

{
  versions.map(({ cls, meta, img }) => (
    <div class:list={["frame", cls]}>
      <img
        src={img.src}
        srcset={img.srcSet.attribute}
        sizes={sizes}
        width={meta.width}
        height={meta.height}
        alt={alt}
        loading={eager && cls !== "only-night" ? "eager" : "lazy"}
        decoding="async"
      />
    </div>
  ))
}

<style>
  .frame,
  img {
    width: 100%;
    height: 100%;
  }
  img {
    display: block;
    object-fit: cover;
    background: var(--sky);
  }
</style>
